---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Learning in Progress"
  description="Get in touch with Syed Mohammad Hamzah for technical feedback, discussions on Data Science, AI, Machine Learning, or GATE DA 2027 preparation."
>
  <div class="container container-narrow contact-page">
    <header class="contact-header">
      <div class="contact-badge">Communication & Inquiries</div>
      <h1 class="contact-title">Get in Touch</h1>
      <p class="contact-lead">
        Have feedback on an article, noticed a technical inaccuracy, or want to discuss Data Science, Machine Learning, or GATE DA 2027? I would love to hear from you.
      </p>
    </header>

    <div class="contact-grid">
      <!-- Direct Info Column -->
      <div class="contact-info-card">
        <h3>Direct Channels</h3>
        <p class="info-desc">
          Feel free to reach out directly via email or connect through professional networks:
        </p>

        <div class="channel-list">
          <div class="channel-item">
            <span class="channel-label">Email:</span>
            <a href="mailto:mohdhamzah1308@gmail.com" class="channel-link">
              mohdhamzah1308@gmail.com
            </a>
          </div>

          <div class="channel-item">
            <span class="channel-label">GitHub:</span>
            <a href="https://github.com/mohdhamzah1308" target="_blank" rel="noopener noreferrer" class="channel-link">
              github.com/mohdhamzah1308
            </a>
          </div>

          <div class="channel-item">
            <span class="channel-label">Academic Profile:</span>
            <span class="channel-text">3rd Year B.Tech CSE &bull; India</span>
          </div>
        </div>

        <div class="response-note">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>As an active engineering student, I typically respond within 24–48 hours.</span>
        </div>
      </div>

      <!-- Contact Message Form -->
      <div class="contact-form-card">
        <h3>Send a Message</h3>
        <p class="form-desc">
          You can use this form to start a conversation or draft an email directly:
        </p>

        <form action="mailto:mohdhamzah1308@gmail.com" method="GET" enctype="text/plain" class="inquiry-form">
          <div class="form-group">
            <label for="subject">Subject / Topic</label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="e.g., Question regarding GATE DA 2027 Linear Algebra post"
              required
            />
          </div>

          <div class="form-group">
            <label for="body">Your Message</label>
            <textarea
              id="body"
              name="body"
              rows="5"
              placeholder="Write your thoughts, critique, question, or feedback here..."
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary submit-btn">
            Send Message &rarr;
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .contact-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-light);
  }

  .contact-badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-base);
    margin-bottom: 0.5rem;
  }

  .contact-title {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .contact-lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-info-card,
  .contact-form-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: 1.75rem;
  }

  .contact-info-card h3,
  .contact-form-card h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.35rem;
  }

  .info-desc,
  .form-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .channel-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .channel-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .channel-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .channel-link {
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--accent-base);
  }

  .channel-link:hover {
    text-decoration: underline;
  }

  .channel-text {
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .response-note {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background-color: var(--bg-subtle);
    padding: 0.85rem 1rem;
    border-radius: 4px;
    font-size: 0.825rem;
    color: var(--text-muted);
    border: 1px solid var(--border-light);
  }

  .response-note svg {
    flex-shrink: 0;
    color: var(--accent-base);
  }

  /* Form */
  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .form-group input,
  .form-group textarea {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    background-color: var(--bg-base);
    color: var(--text-main);
    transition: border-color var(--transition-fast);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-base);
    box-shadow: 0 0 0 2px var(--accent-subtle);
  }

  .submit-btn {
    align-self: flex-start;
    padding: 0.7rem 1.5rem;
  }
</style>

