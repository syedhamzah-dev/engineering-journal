---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../../utils/readingTime';
import { CATEGORIES, slugifyCategory } from '../../../utils/categories';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  return CATEGORIES.map((cat) => {
    const categoryPosts = allPosts
      .filter((post) => slugifyCategory(post.data.category) === cat.slug)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category: cat.slug },
      props: {
        categoryInfo: cat,
        posts: categoryPosts,
      },
    };
  });
}

const { categoryInfo, posts } = Astro.props;
---

<BaseLayout
  title={`${categoryInfo.name} | Category Archive`}
  description={categoryInfo.description}
>
  <div class="container container-wide category-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/blog">Articles</a>
      <span class="sep">/</span>
      <span class="current">Category: {categoryInfo.name}</span>
    </nav>

    <!-- Header -->
    <header class="category-header">
      <div class="category-badge-top">Category Archive</div>
      <h1 class="category-title">{categoryInfo.name}</h1>
      <p class="category-desc">{categoryInfo.description}</p>
      <div class="category-count">
        {posts.length} {posts.length === 1 ? 'article' : 'articles'} in this collection
      </div>
    </header>

    <!-- Navigation between categories -->
    <div class="other-categories-bar">
      <span class="bar-title">Other categories:</span>
      <div class="chips-container">
        {CATEGORIES.map((cat) => (
          <a
            href={`/blog/category/${cat.slug}`}
            class:list={['cat-chip', { active: cat.slug === categoryInfo.slug }]}
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Articles List -->
    <div class="articles-list">
      {posts.length === 0 ? (
        <div class="no-posts">
          <p>No articles published in this category yet. Stay tuned!</p>
          <a href="/blog" class="btn btn-outline">&larr; Back to all articles</a>
        </div>
      ) : (
        posts.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            readingTime={getReadingTime(post.body || '')}
            slug={post.id.replace(/\.[^/.]+$/, '')}
            tags={post.data.tags}
          />
        ))
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .category-page {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  .breadcrumb {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-base);
  }

  .breadcrumb .sep {
    color: var(--border-strong);
  }

  .breadcrumb .current {
    color: var(--text-main);
    font-weight: 500;
  }

  .category-header {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: 2.25rem;
    margin-bottom: 2.5rem;
  }

  .category-badge-top {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-base);
    margin-bottom: 0.5rem;
  }

  .category-title {
    font-size: 2.25rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .category-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 680px;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .category-count {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    border-top: 1px solid var(--border-light);
    padding-top: 0.85rem;
  }

  .other-categories-bar {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bar-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .cat-chip {
    font-size: 0.8rem;
    color: var(--text-secondary);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-light);
    padding: 0.3rem 0.65rem;
    border-radius: 3px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .cat-chip:hover {
    color: var(--accent-base);
    border-color: var(--accent-border);
    background-color: var(--accent-subtle);
  }

  .cat-chip.active {
    background-color: var(--accent-base);
    color: var(--text-inverse);
    border-color: var(--accent-base);
  }

  .articles-list {
    display: flex;
    flex-direction: column;
  }

  .no-posts {
    padding: 3rem 1rem;
    text-align: center;
    background-color: var(--bg-subtle);
    border-radius: 6px;
  }

  .no-posts p {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 640px) {
    .category-header {
      padding: 1.5rem;
    }
    .category-title {
      font-size: 1.75rem;
    }
  }
</style>

