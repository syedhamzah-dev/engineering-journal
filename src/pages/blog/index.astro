---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';
import { CATEGORIES } from '../../utils/categories';

// Exclude draft articles
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="All Articles | Learning in Progress"
  description="Explore all published articles on computer science, programming, data science, AI, machine learning, and GATE DA 2027 by Syed Mohammad Hamzah."
>
  <div class="container container-wide blog-listing-page">
    <!-- Header -->
    <header class="page-header">
      <div class="page-badge">Index of Writings</div>
      <h1 class="page-title">Articles & Field Notes</h1>
      <p class="page-lead">
        A chronological archive of technical explorations, post-mortems, conceptual breakdowns, and study notes. Written from the perspective of an engineering student.
      </p>
    </header>

    <!-- Category Filters -->
    <div class="filter-bar">
      <div class="filter-header">
        <span class="filter-label">Filter by Category:</span>
        <span class="count-badge">{sortedPosts.length} articles</span>
      </div>
      <div class="category-filter-list">
        <a href="/blog" class="filter-chip active">All Categories</a>
        {CATEGORIES.map((cat) => (
          <a href={`/blog/category/${cat.slug}`} class="filter-chip">
            {cat.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Articles List -->
    <div class="articles-container">
      {sortedPosts.length === 0 ? (
        <div class="no-articles">
          <p>No articles published yet. Check back soon!</p>
        </div>
      ) : (
        <div class="articles-feed">
          {sortedPosts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              readingTime={getReadingTime(post.body || '')}
              slug={post.id.replace(/\.[^/.]+$/, '')}
              tags={post.data.tags}
            />
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-listing-page {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-light);
  }

  .page-badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-base);
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2.45rem;
    margin-bottom: 0.75rem;
  }

  .page-lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 720px;
    margin: 0;
  }

  /* Filter Bar */
  .filter-bar {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: 1.25rem;
    margin-bottom: 3rem;
  }

  .filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .filter-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .count-badge {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .category-filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-chip {
    font-size: 0.825rem;
    color: var(--text-secondary);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-light);
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .filter-chip:hover {
    color: var(--accent-base);
    border-color: var(--accent-border);
    background-color: var(--accent-subtle);
  }

  .filter-chip.active {
    background-color: var(--accent-base);
    color: var(--text-inverse);
    border-color: var(--accent-base);
  }

  /* Articles Feed */
  .articles-feed {
    display: flex;
    flex-direction: column;
  }

  .no-articles {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 1.95rem;
    }
  }
</style>

