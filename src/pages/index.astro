---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../utils/readingTime';
import { CATEGORIES } from '../utils/categories';

// Fetch all non-draft posts sorted by pubDate descending
const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = sortedPosts[0];
const recentPosts = sortedPosts.slice(1, 5);
---

<BaseLayout
  title="Learning in Progress | Personal Technology Blog"
  description="An engineering student documenting the journey from curiosity to code, data and intelligence. Articles on Data Science, AI, Machine Learning, and programming by Syed Mohammad Hamzah."
>
  <!-- Hero Section -->
  <section class="hero-section container">
    <div class="hero-inner">
      <div class="hero-badge">Personal Journal &bull; 3rd Year B.Tech CSE</div>
      <h1 class="hero-title">
        Documenting the journey from curiosity to code, data and intelligence.
      </h1>
      <p class="hero-description">
        Welcome to <em>Learning in Progress</em>. I am <strong>Syed Mohammad Hamzah</strong>, a third-year Computer Science and Engineering student. This website is an independent personal publication where I document my hands-on experiments, conceptual breakthroughs, mistakes, and preparation for GATE DA 2027.
      </p>
      <div class="hero-actions">
        <a href="/blog" class="btn btn-primary">
          Browse All Articles &rarr;
        </a>
        <a href="/about" class="btn btn-outline">
          About My Journey
        </a>
      </div>
    </div>
  </section>

  <!-- Categories Strip -->
  <section class="categories-bar-section">
    <div class="container">
      <div class="categories-bar-header">
        <span class="bar-title">Explore by Domain:</span>
      </div>
      <div class="categories-pill-row">
        {CATEGORIES.map((cat) => (
          <a href={`/blog/category/${cat.slug}`} class="category-pill">
            <span class="pill-name">{cat.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured & Latest Articles -->
  <section class="articles-section container">
    {featuredPost && (
      <div class="featured-block">
        <div class="section-label">
          <span>Featured Publication</span>
        </div>
        <ArticleCard
          title={featuredPost.data.title}
          description={featuredPost.data.description}
          pubDate={featuredPost.data.pubDate}
          category={featuredPost.data.category}
          readingTime={getReadingTime(featuredPost.body || '')}
          slug={featuredPost.id.replace(/\.[^/.]+$/, '')}
          tags={featuredPost.data.tags}
          featured={true}
        />
      </div>
    )}

    <div class="latest-block">
      <div class="section-header-row">
        <h2 class="section-heading">Recent Articles</h2>
        <a href="/blog" class="view-all-link">
          View all {sortedPosts.length} articles &rarr;
        </a>
      </div>

      <div class="articles-list">
        {recentPosts.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            readingTime={getReadingTime(post.body || '')}
            slug={post.id.replace(/\.[^/.]+$/, '')}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="about-preview-section">
    <div class="container container-narrow">
      <div class="about-card">
        <div class="about-card-badge">The Philosophy Behind This Blog</div>
        <h2 class="about-card-title">Why an honest, public engineering journal?</h2>
        <p>
          Too much of technology media is optimized for shallow buzzwords and fabricated expertise. As a student entering the critical second half of my undergraduate studies, I wanted a forum that values depth, intellectual honesty, and the actual learning struggle.
        </p>
        <p>
          Whether analyzing high-dimensional vector spaces in Linear Algebra, building Python pipelines for data analytics, or breaking down loss functions in Machine Learning, every article here is written with one goal: <strong>understanding from first principles</strong>.
        </p>
        <div class="about-card-footer">
          <a href="/about" class="btn btn-outline">Read my full background &rarr;</a>
          <a href="/contact" class="btn-subtle">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--border-light);
  }

  .hero-inner {
    max-width: 820px;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-base);
    background-color: var(--accent-subtle);
    border: 1px solid var(--accent-border);
    padding: 0.25rem 0.65rem;
    border-radius: 3px;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 2.85rem;
    line-height: 1.18;
    color: var(--text-main);
    font-weight: 500;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Categories Bar */
  .categories-bar-section {
    background-color: var(--bg-subtle);
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-light);
  }

  .categories-bar-header {
    margin-bottom: 0.65rem;
  }

  .bar-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .categories-pill-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.35rem;
  }

  .category-pill {
    white-space: nowrap;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .category-pill:hover {
    color: var(--accent-base);
    border-color: var(--accent-base);
    background-color: var(--accent-subtle);
  }

  /* Articles Section */
  .articles-section {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .section-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-base);
    margin-bottom: 1rem;
  }

  .featured-block {
    margin-bottom: 3rem;
  }

  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 0.75rem;
  }

  .section-heading {
    margin: 0;
    font-size: 1.6rem;
  }

  .view-all-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-base);
    text-decoration: none;
  }

  .view-all-link:hover {
    color: var(--accent-hover);
  }

  .articles-list {
    display: flex;
    flex-direction: column;
  }

  /* About Preview */
  .about-preview-section {
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    padding: 4.5rem 0;
  }

  .about-card-badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-base);
    margin-bottom: 0.75rem;
  }

  .about-card-title {
    margin-top: 0;
    margin-bottom: 1.25rem;
    font-size: 1.85rem;
  }

  .about-card p {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .about-card-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .btn-subtle {
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
  }

  .btn-subtle:hover {
    color: var(--accent-base);
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.15rem;
    }
    .hero-section {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
    .about-preview-section {
      padding: 3rem 0;
    }
  }
</style>

