---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  category?: string;
  tags?: string[];
  canonicalUrl?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead {...props} />
    <!-- Preconnect to Google Fonts for Newsreader & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body id="top">
    <Header />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .site-main {
    flex: 1 0 auto;
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }
</style>

