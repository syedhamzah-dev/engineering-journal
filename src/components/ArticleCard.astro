---
import { formatDate } from '../utils/date';
import CategoryBadge from './CategoryBadge.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  category: string;
  readingTime: string;
  slug: string;
  tags?: string[];
  featured?: boolean;
}

const {
  title,
  description,
  pubDate,
  category,
  readingTime,
  slug,
  tags = [],
  featured = false,
} = Astro.props;

const formattedDate = formatDate(pubDate);
---

<article class:list={['article-entry', { 'featured-entry': featured }]}>
  <div class="entry-meta">
    <CategoryBadge category={category} />
    <span class="meta-dot">&bull;</span>
    <time datetime={typeof pubDate === 'string' ? pubDate : pubDate.toISOString()} class="entry-date">
      {formattedDate}
    </time>
    <span class="meta-dot">&bull;</span>
    <span class="reading-time">{readingTime}</span>
  </div>

  <h3 class="entry-title">
    <a href={`/blog/${slug}`} class="entry-title-link">
      {title}
    </a>
  </h3>

  <p class="entry-description">
    {description}
  </p>

  <div class="entry-footer">
    <a href={`/blog/${slug}`} class="read-more-link">
      Read article <span class="arrow">&rarr;</span>
    </a>
    {tags && tags.length > 0 && (
      <div class="entry-tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="tag-pill">#{tag}</span>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .article-entry {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border-light);
    transition: transform var(--transition-fast);
  }

  .featured-entry {
    padding: 2.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    margin-bottom: 2rem;
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    color: var(--text-muted);
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }

  .meta-dot {
    color: var(--border-strong);
  }

  .entry-date {
    color: var(--text-secondary);
  }

  .reading-time {
    color: var(--text-muted);
  }

  .entry-title {
    margin-top: 0;
    margin-bottom: 0.65rem;
    font-size: 1.45rem;
    line-height: 1.3;
    font-weight: 600;
  }

  .featured-entry .entry-title {
    font-size: 1.75rem;
  }

  .entry-title-link {
    color: var(--text-main);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .entry-title-link:hover {
    color: var(--accent-base);
  }

  .entry-description {
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.6;
    margin-bottom: 1.15rem;
  }

  .entry-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .read-more-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-base);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .read-more-link .arrow {
    transition: transform var(--transition-fast);
  }

  .read-more-link:hover .arrow {
    transform: translateX(3px);
  }

  .entry-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .featured-entry {
      padding: 1.25rem;
    }
    .entry-title {
      font-size: 1.25rem;
    }
    .featured-entry .entry-title {
      font-size: 1.35rem;
    }
  }
</style>

