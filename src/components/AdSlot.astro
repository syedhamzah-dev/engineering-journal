---
export interface Props {
  slotId?: string;
  format?: 'auto' | 'rectangle' | 'horizontal';
  className?: string;
}

const { slotId = '', format = 'auto', className = '' } = Astro.props;

// AdSense remains disabled by default until your site is approved by Google AdSense.
// Once approved, set PUBLIC_ADSENSE_CLIENT in your environment or update this flag to true.
const isAdEnabled = false; 
const adsenseClient = 'ca-pub-XXXXXXXXXXXXXXXX'; // Replace with your publisher ID once approved
---

{isAdEnabled && slotId ? (
  <aside class={`adsense-slot-container ${className}`} aria-label="Advertisement">
    <span class="ad-label">Advertisement</span>
    <div class="ad-box">
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={adsenseClient}
        data-ad-slot={slotId}
        data-ad-format={format}
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  </aside>
) : null}

<style>
  .adsense-slot-container {
    margin: 2.5rem 0;
    text-align: center;
  }

  .ad-label {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .ad-box {
    min-height: 90px;
    background-color: var(--bg-subtle);
    border: 1px dashed var(--border-light);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    overflow: hidden;
  }
</style>

