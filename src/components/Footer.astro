---
import { CATEGORIES } from '../utils/categories';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Col 1: Brand & Philosophy -->
      <div class="footer-col col-brand">
        <h3 class="footer-brand-title">Learning in Progress</h3>
        <p class="footer-tagline">
          "An engineering student documenting the journey from curiosity to code, data and intelligence."
        </p>
        <p class="footer-note">
          An independent personal publication by Syed Mohammad Hamzah, a 3rd-year B.Tech Computer Science student. Focusing on honest learning, technical depth, real experiments, and preparation for GATE DA 2027.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="footer-col">
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/blog">All Articles</a></li>
          <li><a href="/about">About the Author</a></li>
          <li><a href="/contact">Get in Touch</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/rss.xml">RSS Feed</a></li>
        </ul>
      </div>

      <!-- Col 3: Topics -->
      <div class="footer-col">
        <h4 class="footer-heading">Topics</h4>
        <ul class="footer-links">
          {CATEGORIES.slice(0, 5).map((category) => (
            <li>
              <a href={`/blog/category/${category.slug}`}>{category.name}</a>
            </li>
          ))}
          <li>
            <a href="/blog" class="all-topics-link">Browse all categories &rarr;</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom hairline -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} Syed Mohammad Hamzah. Built with Astro & TypeScript. Designed for clarity, performance, and longevity.
      </p>
      <div class="bottom-links">
        <a href="#top" class="back-to-top">Back to top &uarr;</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-subtle);
    border-top: 1px solid var(--border-light);
    margin-top: auto;
    padding-top: 4rem;
    padding-bottom: 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-brand-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .footer-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.85rem;
    line-height: 1.45;
  }

  .footer-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 0;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-main);
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 0.5rem;
  }

  .footer-links a {
    font-size: 0.88rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--accent-base);
  }

  .all-topics-link {
    font-weight: 500;
    color: var(--accent-base) !important;
  }

  .footer-bottom {
    border-top: 1px solid var(--border-light);
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .footer-bottom p {
    margin: 0;
  }

  .back-to-top {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-to-top:hover {
    color: var(--accent-base);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>

