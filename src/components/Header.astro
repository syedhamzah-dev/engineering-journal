---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Articles' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <div class="brand">
      <a href="/" class="brand-link">
        <span class="brand-title">Learning in Progress</span>
        <span class="brand-subtitle">Engineering, Data & Intelligence</span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => {
          const isActive = link.href === '/' 
            ? currentPath === '/' 
            : currentPath.startsWith(link.href);
          return (
            <li>
              <a href={link.href} class:list={['nav-item', { active: isActive }]}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
      <a href="/rss.xml" class="rss-link" aria-label="RSS Feed" title="RSS Feed">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" />
        </svg>
      </a>
    </nav>

    <!-- Mobile Navigation Toggle -->
    <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobileDrawer">
    <nav aria-label="Mobile Navigation">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => {
          const isActive = link.href === '/' 
            ? currentPath === '/' 
            : currentPath.startsWith(link.href);
          return (
            <li>
              <a href={link.href} class:list={['mobile-nav-item', { active: isActive }]}>
                {link.label}
              </a>
            </li>
          );
        })}
        <li>
          <a href="/rss.xml" class="mobile-nav-item rss-mobile">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11a9 9 0 0 1 9 9" />
              <path d="M4 4a16 16 0 0 1 16 16" />
              <circle cx="5" cy="19" r="1" />
            </svg>
            Subscribe via RSS
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      drawer.classList.toggle('open');
      toggleBtn.classList.toggle('active');
    });
  }
</script>

<style>
  .site-header {
    background-color: var(--bg-base);
    border-bottom: 1px solid var(--border-light);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(8px);
    background-color: rgba(251, 250, 246, 0.95);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text-main);
  }

  .brand-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-main);
    line-height: 1.15;
  }

  .brand-subtitle {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 500;
    margin-top: 2px;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.35rem 0;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-item:hover,
  .nav-item.active {
    color: var(--accent-base);
  }

  .nav-item.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--accent-base);
    border-radius: 1px;
  }

  .rss-link {
    color: var(--text-muted);
    display: flex;
    align-items: center;
    padding: 0.4rem;
    border-radius: 4px;
    transition: all var(--transition-fast);
  }

  .rss-link:hover {
    color: var(--accent-base);
    background-color: var(--bg-subtle);
  }

  /* Mobile menu button */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: var(--text-main);
    transition: all 0.25s ease;
  }

  .mobile-toggle.active .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-toggle.active .bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle.active .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-drawer {
    display: none;
    overflow: hidden;
    background-color: var(--bg-base);
    border-bottom: 1px solid var(--border-light);
    padding: 0 1.5rem;
    max-height: 0;
    transition: max-height 0.3s ease, padding 0.3s ease;
  }

  .mobile-drawer.open {
    max-height: 300px;
    padding: 1rem 1.5rem 1.5rem;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav-item {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-main);
    display: block;
    padding: 0.4rem 0;
  }

  .mobile-nav-item.active {
    color: var(--accent-base);
  }

  .rss-mobile {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .mobile-drawer {
      display: block;
    }
  }
</style>

